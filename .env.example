# NEXUS PROTOCOL — Environment Configuration
# Copy this file to .env.local to enable Supabase Cloud Authentication & PostgreSQL Database.
# Without this file, the application runs in zero-config Local Vault Mode with browser storage.

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public API Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
